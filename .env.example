# LLM provider switch: gemini | safechain | fake. Overrides llm.provider in the config file.
# When it switches provider, the matching model variable below must be set.
LLM_PROVIDER=

# --- Gemini ---
# Gemini API key (secret; never commit .env). GEMINI_API_KEY is accepted as an alias.
GOOGLE_API_KEY=
# Gemini model name; overrides llm.model when the provider is gemini
GEMINI_MODEL=

# --- SafeChain (Amex) ---
# Key under `models:` in the SafeChain YAML ("1" = gpt-5.2, "3" = gpt-5-mini in config_e2.yaml)
SAFECHAIN_MODEL_ID=
# SafeChain's own YAML (idaas + models). Do NOT put it in CONFIG_PATH - that is this app's config.
SAFECHAIN_CONFIG_PATH=./config/safechain.yaml
# IDaaS credentials; the names must match idaas.id_key / idaas.secret_key in the SafeChain YAML
CIBIS_CONSUMER_INTEGRATION_ID=
CIBIS_CONSUMER_SECRET=

# Do NOT set CONFIG_PATH here when using SafeChain: SafeChain reads CONFIG_PATH as ITS config
# path and may reload this .env, so it would read this app's YAML ("No models defined in
# config"). This app defaults to ./config/app.yaml; pass --config to choose another.
LOG_LEVEL=INFO
