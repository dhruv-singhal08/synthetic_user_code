{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "run",
      "type": "debugpy",
      "request": "launch",
      "module": "synthetic_user.cli",
      "args": ["run", "--config", "${workspaceFolder}/config/app.yaml"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "justMyCode": true
    },
    {
      "name": "pytest",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "args": ["-q"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
